*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.icon binary
*.m4a binary
*.wav binary
*.mp3 binary
*.mlmodelc/** binary
*.ico binary

# The bridge fixtures are compared byte for byte by the Swift, web and Rust
# contract tests; keep them LF on every platform.
apps/macos/web/fixtures/bridge/*.json text eol=lf
# Goldens and fixtures compared byte for byte by the Swift and Rust tests:
# never converted, so a Windows checkout keeps their LF line endings.
Tests/Fixtures/** -text

# The LLM fixtures are read by the Swift and Rust tests: the prompt goldens
# are compared byte for byte and the token budgets count bytes; keep them LF
# on every platform.
Tests/Fixtures/llm/** text eol=lf
