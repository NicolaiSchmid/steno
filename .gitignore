# macOS
.DS_Store

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcodeproj
!*.xcodeproj/project.xcworkspace/xcshareddata/
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM.zip
*.dSYM

# Downloaded ML models never go into git
*.mlpackage
*.mlmodelc
*.onnx
*.gguf

# Secrets and local env
.env
.env.*
!.env.example

# Node (mobile/ has its own .gitignore for Expo output)
node_modules/

# Claude Code local state stays untracked, but the project skill entries
# (symlinks into .agents/skills, the authoritative source) are committed.
.claude/*
!.claude/skills/

# Snapshot mismatches write the actual bytes beside the golden for inspection
Tests/Fixtures/**/*.actual

# macOS app: xcodegen output and per-machine overrides (apps/macos/project.yml is the source)
apps/macos/*.xcodeproj
apps/macos/Steno/Info.plist
apps/macos/Config/Steno.entitlements
apps/macos/Config/Local.xcconfig
apps/macos/build/
apps/macos/dist/
