{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steno",
  "identifier": "uno.schmid.steno.desktop",
  "build": {
    "frontendDist": "../../macos/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../macos/web"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../macos/web"
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "steno"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQkJCRDA2N0IzMjE0QTkKUldTcEZESjdCcjI3K3ZZK0tCTXBKb1pNSGFiYVZzZyt1Z0dXc0QzblVhYjdhN292bzVKQnk1MHUK",
      "endpoints": [
        "https://github.com/NicolaiSchmid/steno/releases/download/desktop-stable/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Nicolai Schmid",
    "homepage": "https://github.com/NicolaiSchmid/steno",
    "category": "Productivity",
    "shortDescription": "Bot-free meeting recorder",
    "longDescription": "Records your calls and in-person meetings on this device, transcribes them locally and writes the notes where you keep them. Audio never leaves the device.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "section": "sound",
        "depends": [
          "libayatana-appindicator3-1",
          "libc6 (>= 2.39)",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "pipewire"
        ],
        "desktopTemplate": "linux/steno-desktop.desktop",
        "postInstallScript": "linux/deb-postinst.sh",
        "files": {
          "/usr/lib/systemd/user/app-steno\\x2ddesktop@autostart.service.d/10-steno.conf": "linux/autostart-service-stop-timeout.conf",
          "/usr/lib/systemd/user/app-gnome-steno\\x2ddesktop-.scope.d/zz-steno.conf": "linux/gnome-scope-stop-timeout.conf"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
