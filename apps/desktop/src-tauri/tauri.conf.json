{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steno",
  "identifier": "uno.schmid.steno.desktop",
  "build": {
    "frontendDist": "../../macos/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../macos/web" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../macos/web" }
  },
  "app": {
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
