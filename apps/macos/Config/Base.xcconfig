// Shared by Debug and Release. Identifiers here are immutable once a build
// ships (.plans/2026-09-25-v1-program.md): TCC, Sparkle and the login item
// key off the bundle id and the team.
DEVELOPMENT_TEAM = KQB68F43PW
PRODUCT_BUNDLE_IDENTIFIER = uno.schmid.steno.mac

MACOSX_DEPLOYMENT_TARGET = 15.0
SDKROOT = macosx
// Apple Silicon only.
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
SWIFT_EMIT_LOC_STRINGS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

// Local builds and CI are 0.0.0 (0); release.yml passes the tag's version
// and `git rev-list --count HEAD` on the xcodebuild command line.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 0

// No App Sandbox: process taps, `afplay` in the permission probe and the
// login-keychain handover identity all need the unsandboxed process.
ENABLE_APP_SANDBOX = NO
GENERATE_INFOPLIST_FILE = NO
COMBINE_HIDPI_IMAGES = YES
