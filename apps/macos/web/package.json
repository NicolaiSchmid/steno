{
	"name": "@steno/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "vite build && node scripts/check-offline.mjs && node scripts/check-bundle.mjs",
		"build:screens": "vite build --mode screens",
		"check": "pnpm lint && pnpm lint:ui && pnpm typecheck && pnpm test",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:offline": "node scripts/check-offline.mjs",
		"dev": "vite",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ui": "node scripts/check-ui-restyle.mjs",
		"preview": "vite preview --mode screens",
		"screens": "pnpm build:screens && playwright test",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@tauri-apps/api": "^2.12.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.49.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	}
}
