# Build variant: development | preview | production
APP_VARIANT=development
# EAS / Expo workspace (from `eas init`). EXPO_OWNER is the Expo account slug;
# EAS_PROJECT_ID is the uuid `eas init` prints. Needed for EAS builds and OTA
# updates; app.config.ts carries the committed default once minted.
EXPO_OWNER=nicolaischmid
EAS_PROJECT_ID=

# No EXPO_PUBLIC_* runtime endpoints yet: the recorder talks only to the Mac
# it is paired with on the local network. When the first one appears, add it
# to src/lib/env.ts via readRequired() and restore the env-contract gate in
# .github/workflows/mobile-cd.yml.
