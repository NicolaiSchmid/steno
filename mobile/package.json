{
	"name": "@steno/mobile",
	"version": "0.1.0",
	"private": true,
	"main": "index.ts",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"start": "expo start --dev-client",
		"start:clear": "expo start --dev-client --clear",
		"ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
		"prebuild": "expo prebuild --clean --platform ios",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@expo-google-fonts/geist": "^0.4.2",
		"@react-navigation/native": "^7.1.0",
		"@react-navigation/native-stack": "^7.3.0",
		"clsx": "^2.1.1",
		"expo": "~57.0.19",
		"expo-audio": "~57.0.4",
		"expo-camera": "~57.0.5",
		"expo-constants": "~57.0.0",
		"expo-crypto": "~57.0.3",
		"expo-dev-client": "~57.0.0",
		"expo-file-system": "~57.0.0",
		"expo-font": "~57.0.0",
		"expo-secure-store": "~57.0.0",
		"expo-splash-screen": "~57.0.0",
		"expo-status-bar": "~57.0.0",
		"expo-symbols": "~57.0.0",
		"expo-system-ui": "~57.0.0",
		"expo-updates": "~57.0.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "^2.30.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.10.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"uniwind": "^1.11.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@types/react": "~19.2.0",
		"babel-preset-expo": "~57.0.0",
		"happy-dom": "^20.14.5",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	}
}
