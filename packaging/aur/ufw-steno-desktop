# The phone handover's port (HandoverConfiguration::LINUX_PORT in
# crates/steno-handover). Open it with `sudo ufw allow Steno`. ufw's own
# rules already admit mDNS (5353/udp), which the phone finds Steno by.
[Steno]
title=Steno phone handover
description=Receives recordings from the paired phone on the local network over TLS 1.3
ports=23820/tcp
