{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "pnpm install --frozen-lockfile --filter @steno/site...",
	"buildCommand": "pnpm build:site",
	"outputDirectory": "apps/site/out",
	"ignoreCommand": "[ -d apps/site ] || exit 0; git diff --quiet HEAD^ HEAD -- apps/site package.json pnpm-lock.yaml pnpm-workspace.yaml vercel.json",
	"cleanUrls": true,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/opengraph-image",
			"headers": [{ "key": "Content-Type", "value": "image/png" }]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
